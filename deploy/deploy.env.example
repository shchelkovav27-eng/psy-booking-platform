# Скопируйте в deploy/deploy.env и заполните. deploy.env в git не попадает.
DEPLOY_HOST="deploy@server.example.com"   # пользователь@хост виртуального хостинга
SSH_KEY="$HOME/.ssh/id_ed25519"            # путь к ключу
SSH_PORT="22"
REMOTE_ROOT="public_html"                  # корень сайтов на сервере (относительно ~)
SITE_URL="https://booking.example.com"     # публичный адрес, без завершающего /
APP="shkola"                               # zapis | shkola | soprovod
